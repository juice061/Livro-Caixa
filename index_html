function Orcamento({data, definirOrcamento}) {
  const mesAtual = hoje().slice(0,7);
  const gastosPorCategoria = {};
  data.transactions.filter(t=>t.type==="gasto" && t.date.slice(0,7)===mesAtual).forEach(t=>{ gastosPorCategoria[t.category]=(gastosPorCategoria[t.category]||0)+t.amount; });
  const totalGastoMes = Object.values(gastosPorCategoria).reduce((a,b)=>a+b,0);
  const [edicoes, setEdicoes] = useState({});

  const salvar = (categoria) => {
    const valor = parseFloat(edicoes[categoria]);
    if (isNaN(valor) || valor<0) { toast(false,"Informe um valor válido."); return; }
    definirOrcamento(categoria, valor);
    setEdicoes(e=>({...e, [categoria]: ""}));
    toast(true,`Orçamento de ${categoria} definido em ${fmt(valor)}.`);
  };
  const remover = (categoria) => { definirOrcamento(categoria, null); toast(true,`Orçamento de ${categoria} removido.`); };

  const categoriasOrdenadas = [...CATEGORIAS_GASTO].sort((a,b)=>(gastosPorCategoria[b]||0)-(gastosPorCategoria[a]||0));

  return <div className="stack">
    {totalGastoMes>0 && <Card>
      <SectionTitle sub="Quanto você já gastou em cada categoria neste mês.">📊 Resumo do mês por categoria</SectionTitle>
      <div className="stack-sm">
        {categoriasOrdenadas.filter(cat=>gastosPorCategoria[cat]>0).map(cat=>{
          const gasto = gastosPorCategoria[cat]||0;
          const pct = (gasto/totalGastoMes)*100;
          return <div key={cat}>
            <div className="row-between" style={{fontSize:12,marginBottom:3}}>
              <span>{EMOJI_CATEGORIA[cat]||"•"} {cat}</span>
              <span className="mono">{fmt(gasto)} <span className="muted">({Math.round(pct)}%)</span></span>
            </div>
            <Progress value={gasto} max={totalGastoMes} color="#5A8FBF" />
          </div>;
        })}
      </div>
    </Card>}
    <Card>
      <SectionTitle sub="Defina um limite mensal por categoria de gasto (opcional). Você recebe um aviso quando ultrapassar 80% e quando passar do limite.">🧾 Orçamento por categoria</SectionTitle>
      <div className="stack-sm">
        {CATEGORIAS_GASTO.map(cat => {
          const limite = data.orcamentos ? data.orcamentos[cat] : null;
          const gasto = gastosPorCategoria[cat] || 0;
          const pct = limite ? (gasto/limite)*100 : 0;
          const cor = pct>=100 ? "#A13D3D" : pct>=80 ? "#B08D3F" : "#3A6B54";
          return <div key={cat} style={{paddingBottom:12, borderBottom:"1px solid rgba(16,24,32,.08)"}}>
            <div className="row-between" style={{marginBottom:4}}>
              <span style={{fontSize:13,fontWeight:600}}>{EMOJI_CATEGORIA[cat]||"•"} {cat}</span>
              <span className="mono" style={{fontSize:12}}>{fmt(gasto)}{limite ? ` / ${fmt(limite)}` : ""}</span>
            </div>
            {limite ? <Progress value={gasto} max={limite} color={cor} /> : null}
            <div className="row g2" style={{marginTop:8}}>
              <input type="number" placeholder={limite?`Alterar limite (atual ${fmt(limite)})`:"Definir limite mensal"} value={edicoes[cat]||""} onChange={e=>setEdicoes({...edicoes,[cat]:e.target.value})} className="flex1" style={{padding:"6px 10px"}} />
              <button className="btn-ghost" style={{fontSize:12,padding:"6px 10px"}} onClick={()=>salvar(cat)}>Salvar</button>
              {limite ? <IconBtn onClick={()=>remover(cat)} title="Remover limite">🗑️</IconBtn> : null}
            </div>
          </div>;
        })}
      </div>
    </Card>
  </div>;
}

