  const pReservado = (totalReservado/patrimonioTotal)*100;
  const pInvestido = (totalInvestido/patrimonioTotal)*100;
  return <div style={{marginTop:16}}>
    <div className="row" style={{height:10,borderRadius:999,overflow:"hidden",background:"rgba(239,234,218,.1)"}}>
      <div style={{width:`${pConta}%`,background:"#6FB596",height:"100%"}} />
      <div style={{width:`${pReservado}%`,background:"#B08D3F",height:"100%"}} />
      <div style={{width:`${pInvestido}%`,background:"#5A8FBF",height:"100%"}} />
