      <div className="row g2" style={{marginBottom:8}}>
        <input className="flex1" type="number" placeholder="Valor alvo" value={form.target} onChange={e=>setForm({...form,target:e.target.value})} />
        <input className="flex1" type="date" value={form.deadline} onChange={e=>setForm({...form,deadline:e.target.value})} />
      </div>
      <div className="row g2" style={{marginBottom:8}}>
        {[[false,"Guardar à parte"],[true,"Acompanhar investido"]].map(([val,label])=>(
          <button key={String(val)} className="flex1" style={{fontSize:12,background: form.linked===val?"#101820":"rgba(16,24,32,.06)", color: form.linked===val?"#EFEADA":"#101820"}} onClick={()=>setForm({...form,linked:val})}>{label}</button>
        ))}
      </div>
      <button className="btn-primary wfull" onClick={submit}>Criar</button>
    </Card>
    {metas.length===0 && <p className="muted" style={{textAlign:"center"}}>Nenhuma meta financeira criada ainda.</p>}
    <div className="stack-sm">
      {metas.map(m=>{
        const atual = m.linkedToInvestments ? totalInvestido : m.saved;
        const pct = (atual/m.target)*100; const atingida = atual>=m.target;
        return <Card key={m.id} accent="#B08D3F">
          {atingida && <Stamp text="META ATINGIDA" />}
          <div className="row-between" style={{marginBottom:6}}>
            <div>
              <div className="row g2"><span style={{fontWeight:600,fontSize:15}}>{m.name}</span>{m.linkedToInvestments && <span style={{fontSize:10,background:"rgba(90,143,191,.15)",color:"#5A8FBF",padding:"2px 6px",borderRadius:4}}>INVESTIMENTOS</span>}</div>
              {m.deadline && <div className="muted">até {new Date(m.deadline+"T00:00").toLocaleDateString("pt-BR")}</div>}
            </div>
            <IconBtn onClick={()=>excluir(m)} title="Excluir">🗑️</IconBtn>
          </div>
          <div className="row-between mono" style={{fontSize:12,marginBottom:4}}><span>{fmt(atual)} / {fmt(m.target)}</span><PercentTag value={pct} color="#B08D3F" /></div>
          <Progress value={atual} max={m.target} color="#B08D3F" />
          {m.linkedToInvestments ? <p className="muted" style={{marginTop:8}}>Sincronizada com sua aba Investimentos — aporte lá para avançar essa meta.</p>
            : (!atingida && <AporteBox item={m} atual={m.saved} saldo={saldo} tipo="financeira" contribuir={contribuir} resgatar={resgatar} />)}
        </Card>;
      })}
    </div>
  </div>;
}

function MetasMateriais({metas, saldo, add, contribuir, resgatar, excluir, pagarParcela, quitarRestante}) {
  const [form,setForm] = useState({name:"",price:"",priority:"media",mode:"avista",installments:"3",dueDay:"10"});
  const corPrioridade = {alta:"#A13D3D",media:"#B08D3F",baixa:"#7A7460"};
  const submit = () => {
    if (!form.name||!form.price) return;
    const base = {name:form.name,price:parseFloat(form.price),priority:form.priority,saved:0,mode:form.mode};
    if (form.mode==="parcelado") { base.installments = Math.max(1,parseInt(form.installments)||1); base.installmentsPaid=0; base.dueDay=Math.min(28,Math.max(1,parseInt(form.dueDay)||10)); base.criadoEm=hoje(); }
    add(base); setForm({name:"",price:"",priority:"media",mode:"avista",installments:"3",dueDay:"10"});
    toast(true,"Item adicionado.");
  };
  return <div className="stack">
    <Card>
      <SectionTitle sub="Economize aos poucos, ou parcele quando for urgente.">Novo item desejado</SectionTitle>
      <input className="wfull" style={{marginBottom:8}} placeholder="O que você quer comprar?" value={form.name} onChange={e=>setForm({...form,name:e.target.value})} />
      <div className="grid2" style={{marginBottom:8}}>
        <input type="number" placeholder="Preço total" value={form.price} onChange={e=>setForm({...form,price:e.target.value})} />
        <select value={form.priority} onChange={e=>setForm({...form,priority:e.target.value})}><option value="alta">Prioridade alta</option><option value="media">Prioridade média</option><option value="baixa">Prioridade baixa</option></select>
      </div>
      <div className="row g2" style={{marginBottom:8}}>
        {[["avista","Economizar (à vista)"],["parcelado","Parcelar (urgente)"]].map(([val,label])=>(
          <button key={val} className="flex1" style={{fontSize:12,background: form.mode===val?"#101820":"rgba(16,24,32,.06)", color: form.mode===val?"#EFEADA":"#101820"}} onClick={()=>setForm({...form,mode:val})}>{label}</button>
        ))}
      </div>
      {form.mode==="parcelado" && <div className="row g2" style={{marginBottom:8,alignItems:"center"}}>
        <input className="flex1" type="number" min="1" placeholder="Nº de parcelas" value={form.installments} onChange={e=>setForm({...form,installments:e.target.value})} />
        <input className="flex1" type="number" min="1" max="28" placeholder="Dia de vencimento" value={form.dueDay} onChange={e=>setForm({...form,dueDay:e.target.value})} />
        {form.price && form.installments>0 && <span className="mono muted">{fmt(parseFloat(form.price)/(parseInt(form.installments)||1))}/parcela</span>}
      </div>}
      <button className="btn-primary wfull" onClick={submit}>Criar</button>
    </Card>
    {metas.length===0 && <p className="muted" style={{textAlign:"center"}}>Sua lista de desejos está vazia.</p>}
    <div className="stack-sm">
      {[...metas].sort((a,b)=>(a.saved>=a.price)-(b.saved>=b.price)).map(m=>{
        const done = m.saved>=m.price; const parcelado = m.mode==="parcelado"; const pct=(m.saved/m.price)*100;
        return <Card key={m.id} accent={corPrioridade[m.priority]} style={{opacity: done ? 0.85 : 1}}>
          {done && <Stamp text={parcelado?"QUITADO":"CONQUISTADO"} />}
          <div className="row-between" style={{marginBottom:6}}>
            <div className="row g2"><span style={{width:8,height:8,borderRadius:"50%",background:corPrioridade[m.priority]}} /><span style={{fontWeight:600,fontSize:15}}>{m.name}</span>{parcelado && <span style={{fontSize:10,background:"rgba(16,24,32,.08)",padding:"2px 6px",borderRadius:4,color:"#7A7460"}}>PARCELADO</span>}</div>
            <IconBtn onClick={()=>excluir(m)} title="Excluir">🗑️</IconBtn>
          </div>
          <div className="row-between mono" style={{fontSize:12,marginBottom:4}}>
            <span>{fmt(m.saved)} / {fmt(m.price)}{parcelado && ` · parcela ${m.installmentsPaid}/${m.installments}`}</span>
            <PercentTag value={pct} color={corPrioridade[m.priority]} />
