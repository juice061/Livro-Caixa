<script type="text/plain" id="app-source">
const { useState, useEffect, useMemo, useRef, useCallback } = React;

/* ===================== som (sintetizado, sem arquivos externos) ===================== */
let somLigado = (typeof localStorage!=="undefined" && localStorage.getItem("livro-caixa-som")==="off") ? false : true;
let audioCtx = null;
function getAudioCtx(){
  if (!audioCtx) { const Ctor = window.AudioContext||window.webkitAudioContext; if (!Ctor) return null; audioCtx = new Ctor(); }
  if (audioCtx.state === "suspended") audioCtx.resume();
  return audioCtx;
}
function playTone(freq, start, duration, type, gainPeak){
  const ctx = getAudioCtx(); if (!ctx) return;
  const osc = ctx.createOscillator(); const gain = ctx.createGain();
  osc.type = type||"sine"; osc.frequency.value = freq;
  osc.connect(gain); gain.connect(ctx.destination);
  const t0 = ctx.currentTime + (start||0);
  gain.gain.setValueAtTime(0.0001, t0);
  gain.gain.linearRampToValueAtTime(gainPeak||0.12, t0+0.012);
  gain.gain.exponentialRampToValueAtTime(0.0001, t0+(duration||0.1));
  osc.start(t0); osc.stop(t0+(duration||0.1)+0.03);
}
function playClickPop(){ if(!somLigado) return; playTone(720,0,0.07,"sine",0.10); playTone(980,0.015,0.06,"sine",0.05); }
function playHoverTick(){ if(!somLigado || !audioCtx || audioCtx.state!=="running") return; playTone(1400,0,0.035,"sine",0.035); }
function playCelebracao(){
  if(!somLigado) return;
  const notas = [523.25,659.25,783.99,1046.5,1318.5];
  notas.forEach((f,i)=> playTone(f, i*0.085, 0.32, "triangle", 0.13));
}
function alternarSom(){ somLigado = !somLigado; try{ localStorage.setItem("livro-caixa-som", somLigado?"on":"off"); }catch(e){} if(somLigado) playClickPop(); return somLigado; }

/* ===================== celebração ao bater metas ===================== */
function celebrar(){
  playCelebracao();
  const cores = ["#B08D3F","#3A6B54","#A13D3D","#5A8FBF","#EFEADA"];
  const container = document.createElement("div");
  container.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:9998;overflow:hidden;";
  document.body.appendChild(container);
  for (let i=0;i<32;i++){
    const el = document.createElement("div");
    const cor = cores[Math.floor(Math.random()*cores.length)];
    const left = Math.random()*100;
    const size = 6+Math.random()*7;
    const duration = 1.6+Math.random()*1.3;
    const delay = Math.random()*0.35;
    el.style.cssText = `position:absolute;left:${left}vw;top:-24px;width:${size}px;height:${size}px;background:${cor};opacity:.9;border-radius:${Math.random()>0.5?"50%":"2px"};transform:rotate(${Math.random()*360}deg);animation:confettiFall ${duration}s ease-in ${delay}s forwards;`;
    container.appendChild(el);
  }
  setTimeout(()=>container.remove(), 3300);
}

/* ===================== notificações (toasts) ===================== */
function toast(ok, text){
  window.dispatchEvent(new CustomEvent("app-toast", { detail: { ok, text, id: uid("toast") } }));
}
function ToastContainer(){
  const [toasts, setToasts] = useState([]);
  useEffect(()=>{
    const handler = (e) => {
      setToasts(t => [...t, e.detail]);
      setTimeout(()=> setToasts(t => t.filter(x => x.id !== e.detail.id)), 3100);
    };
    window.addEventListener("app-toast", handler);
    return () => window.removeEventListener("app-toast", handler);
  },[]);
  return <div className="toast-wrap">{toasts.map(t => <div key={t.id} className={"toast "+(t.ok?"toast-ok":"toast-err")}>{t.text}</div>)}</div>;
}

/* ===================== número animado (contador suave) ===================== */
function useCountUp(value, duration=650){
  const [display, setDisplay] = useState(value);
  const prevRef = useRef(value);
  const frameRef = useRef(null);
  useEffect(()=>{
    const from = prevRef.current, to = value;
    if (from === to) return;
    if (frameRef.current) cancelAnimationFrame(frameRef.current);
    let start = null;
    function step(ts){
      if (!start) start = ts;
      const progress = Math.min(1, (ts-start)/duration);
      const eased = 1-Math.pow(1-progress,3);
      setDisplay(from + (to-from)*eased);
      if (progress<1) frameRef.current = requestAnimationFrame(step);
      else prevRef.current = to;
    }
    frameRef.current = requestAnimationFrame(step);
    return ()=> frameRef.current && cancelAnimationFrame(frameRef.current);
  },[value]);
  return display;
}

/* ===================== trava de PIN (local, por aparelho) ===================== */
const PIN_KEY = "livro-caixa-pin";
function hashSimples(str){
  let h = 0;
  for (let i=0;i<str.length;i++){ h = (h*31 + str.charCodeAt(i)) >>> 0; }
  return h.toString(36);
}
function LockGate({children}) {
  const [pinSalvo] = useState(()=>{ try{ return localStorage.getItem(PIN_KEY)||""; }catch(e){ return ""; } });
  const [desbloqueado, setDesbloqueado] = useState(!pinSalvo);
  const [digitado, setDigitado] = useState("");
  const [erro, setErro] = useState(false);

  const tentar = () => {
    if (digitado && hashSimples(digitado) === pinSalvo) { setDesbloqueado(true); }
    else { setErro(true); setDigitado(""); setTimeout(()=>setErro(false), 450); }
  };

  if (desbloqueado) return children;

  return (
    <div style={{minHeight:"100vh", background:"#101820", display:"flex", flexDirection:"column", alignItems:"center", justifyContent:"center", gap:16, padding:24}}>
      <Logo size={56} />
      <div className="serif" style={{color:"#EFEADA", fontSize:20}}>Livro-Caixa</div>
      <p className="muted">Digite seu PIN pra continuar</p>
      <input autoFocus type="password" inputMode="numeric" pattern="[0-9]*" maxLength={6} value={digitado}
        onChange={e=>setDigitado(e.target.value.replace(/\D/g,""))}
        onKeyDown={e=>e.key==="Enter" && tentar()}
        className={erro?"pin-shake":""}
        style={{fontSize:26, letterSpacing:10, textAlign:"center", width:180, padding:"10px 14px", borderColor: erro?"#A13D3D":undefined}} />
      <button className="btn-gold" onClick={tentar}>Entrar</button>
    </div>
  );
}

/* ===================== compressão de imagem (anexo de comprovante) ===================== */
function comprimirImagem(file, maxLargura=800, qualidade=0.6){
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        let w = img.width, h = img.height;
        if (w > maxLargura) { h = Math.round(h*(maxLargura/w)); w = maxLargura; }
        const canvas = document.createElement("canvas");
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL("image/jpeg", qualidade));
      };
      img.onerror = reject;
      img.src = e.target.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

/* ===================== evolução do patrimônio (reconstruída do histórico) ===================== */
function calcularEvolucaoPatrimonio(data){
  const eventos = [];
  data.transactions.forEach(t => eventos.push({ date:t.date, tipo:"transacao", valor: t.type==="ganho"?t.amount:-t.amount, categoria:t.category }));
  data.investimentos.forEach(inv => (inv.historico||[]).forEach(h => eventos.push({ date:h.date, tipo:"rendimento", valor:h.valor })));
  if (!eventos.length) return [];
  eventos.sort((a,b)=> a.date.localeCompare(b.date));

  const primeiroMes = eventos[0].date.slice(0,7);
  const mesAtual = hoje().slice(0,7);
  const meses = [];
  let cursor = new Date(primeiroMes+"-01T00:00:00");
  const fim = new Date(mesAtual+"-01T00:00:00");
  let guarda = 0;
  while (cursor <= fim && guarda < 240) {
    meses.push(cursor.toISOString().slice(0,7));
    cursor = new Date(cursor.getFullYear(), cursor.getMonth()+1, 1);
    guarda++;
  }

  let saldoAcum=0, reservadoAcum=0, investidoAcum=0, idx=0;
  return meses.map(mes => {
    while (idx < eventos.length && eventos[idx].date.slice(0,7) <= mes) {
      const ev = eventos[idx];
      if (ev.tipo==="transacao") {
        saldoAcum += ev.valor;
        if (ev.categoria==="Reserva de meta" || ev.categoria==="Reserva de meta material") reservadoAcum += Math.abs(ev.valor);
        if (ev.categoria==="Resgate de meta" || ev.categoria==="Resgate de meta material") reservadoAcum -= Math.abs(ev.valor);
        if (ev.categoria==="Aporte em investimento") investidoAcum += Math.abs(ev.valor);
        if (ev.categoria==="Resgate de investimento") investidoAcum -= Math.abs(ev.valor);
      } else { investidoAcum += ev.valor; }
      idx++;
    }
    return {
      mes, label: new Date(mes+"-02").toLocaleDateString("pt-BR",{month:"short",year:"2-digit"}),
      saldo: round2(saldoAcum), reservado: round2(reservadoAcum), investido: round2(investidoAcum),
      patrimonio: round2(saldoAcum+reservadoAcum+investidoAcum)
    };
  });
}

