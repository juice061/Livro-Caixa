function Legenda({cor,label,pct}) {
  return <div className="row g1" style={{fontSize:11,color:"#9B9480"}}>
    <span style={{width:7,height:7,borderRadius:"50%",background:cor}} />{label} <span className="mono" style={{color:"#EFEADA"}}>{Math.round(pct)}%</span>
