}

function MiniBarChart({dados}) {
  const max = Math.max(1, ...dados.flatMap(d=>[d.ganhos,d.gastos]));
  return <div className="row" style={{alignItems:"flex-end",gap:16,height:180,paddingTop:10}}>
    {dados.map((d,i)=>(
      <div key={i} className="col" style={{alignItems:"center",flex:1,gap:6,height:"100%",justifyContent:"flex-end"}}>
        <div className="row g1" style={{alignItems:"flex-end",height:140}}>
          <div title={fmt(d.ganhos)} style={{width:14,borderRadius:"3px 3px 0 0",background:"#3A6B54",height:`${(d.ganhos/max)*100}%`}} />
          <div title={fmt(d.gastos)} style={{width:14,borderRadius:"3px 3px 0 0",background:"#A13D3D",height:`${(d.gastos/max)*100}%`}} />
        </div>
        <span style={{fontSize:11,color:"#101820"}}>{d.label}</span>
      </div>
    ))}
  </div>;
}

function LineChartPatrimonio({dados}) {
  if (dados.length < 2) return <p className="muted" style={{textAlign:"center", padding:"12px 0"}}>Continue registrando pra ver a evolução ao longo dos meses.</p>;
  const w = 600, h = 160, padY = 18;
  const valores = dados.map(d=>d.patrimonio);
  const max = Math.max(1, ...valores);
  const min = Math.min(0, ...valores);
  const range = (max-min)||1;
  const pontos = dados.map((d,i) => {
    const x = (i/(dados.length-1)) * (w-20) + 10;
    const y = h - padY - ((d.patrimonio-min)/range)*(h-padY*2);
    return [x,y];
  });
  return (
    <div style={{overflowX:"auto"}}>
      <svg viewBox={`0 0 ${w} ${h}`} width="100%" height={h} style={{minWidth:360}}>
        <polyline points={pontos.map(p=>p.join(",")).join(" ")} fill="none" stroke="#B08D3F" strokeWidth="2.5" strokeLinejoin="round" strokeLinecap="round" />
        {pontos.map(([x,y],i)=>(
          <circle key={i} cx={x} cy={y} r="3.5" fill="#101820">
            <title>{dados[i].label}: {fmt(dados[i].patrimonio)}</title>
          </circle>
        ))}
      </svg>
      <div className="row-between" style={{fontSize:10,color:"#7A7460",padding:"0 10px"}}>
        <span>{dados[0].label}</span><span>{dados[dados.length-1].label}</span>
      </div>
    </div>
  );
}

function PrioridadesPainel({prioridades}) {
  if (!prioridades.length) return null;
  return <Card>
    <SectionTitle sub="Mensalidades e parcelas mais próximas do vencimento, pra você não atrasar nada.">🔔 Prioridades do mês</SectionTitle>
    <div className="stack-sm">
      {prioridades.map((p,i)=>{
        const classe = p.dias<0 ? "priority-atrasada" : p.dias<=5 ? "priority-urgente" : "priority-ok";
        const texto = p.dias<0 ? `atrasada há ${Math.abs(p.dias)} dia(s)` : p.dias===0 ? "vence hoje" : `vence em ${p.dias} dia(s)`;
        return <div key={i} className={"row-between priority-item "+classe}>
          <span>{p.dias<0?"🔴":p.dias<=5?"🟠":"🟢"} <strong>{p.nome}</strong> <span className="muted">({p.tipo})</span></span>
          <span className="mono">{fmt(p.valor)} · {texto}</span>
        </div>;
      })}
    </div>
  </Card>;
}

