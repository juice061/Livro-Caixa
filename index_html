async function buscarNoticias(){
  const resultados = [];
  for (const feed of FEEDS_NOTICIAS){
    try {
      const resp = await fetch(`https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feed.url)}`);
      const json = await resp.json();
      if (json.status==="ok" && json.items) json.items.slice(0,6).forEach(it=> resultados.push({ titulo:it.title, link:it.link, data:it.pubDate, fonte:feed.nome }));
    } catch(e){}
  }
  return resultados.sort((a,b)=> new Date(b.data)-new Date(a.data));
}

