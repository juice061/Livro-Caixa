      <Card accent="#A13D3D"><div style={{color:"#A13D3D",fontSize:12}}>📉 GASTOS</div><div className="mono" style={{fontSize:21,fontWeight:700}}>{fmt(gastosTotais)}</div></Card>
    </div>
    {evolucaoPatrimonio && evolucaoPatrimonio.length>1 && <Card><SectionTitle sub="Reconstruído a partir do seu histórico de lançamentos e rendimentos.">Evolução do patrimônio</SectionTitle><LineChartPatrimonio dados={evolucaoPatrimonio} /></Card>}
