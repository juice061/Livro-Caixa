  );
}

function RendimentoBox({inv, registrarRendimento}) {
  const [valor,setValor]=useState(""); const [erro,setErro]=useState("");
  const acumulado = (inv.historico||[]).reduce((a,h)=>a+h.valor,0);

  const hojeD = new Date(); hojeD.setHours(0,0,0,0);
  const baseData = inv.ultimoRendimento || inv.criadoEm || null;
  const diasPassados = baseData ? Math.floor((hojeD - new Date(baseData+"T00:00:00")) / 86400000) : 30;
  const bloqueado = diasPassados < 30;
  const diasRestantes = Math.max(0, 30 - diasPassados);

  const executar = () => {
    const v = parseFloat(valor);
    if (isNaN(v) || v===0) { setErro("Informe um número (negativo pra prejuízo)."); return; }
    const r = registrarRendimento(inv, v);
    if (!r.ok) { setErro(r.msg); return; }
    setErro(""); setValor("");
  };

  return <div style={{marginTop:10, paddingTop:10, borderTop:"1px dashed rgba(16,24,32,.15)"}}>
    <div className="row-between" style={{marginBottom:10}}>
      <span className="muted">Rendimento acumulado</span>
      <span className="mono" style={{color: acumulado>=0?"#3A6B54":"#A13D3D", fontWeight:700, fontSize:13}}>{acumulado>=0?"+":""}{fmt(acumulado)}</span>
    </div>
    {bloqueado ? (
      <div className="row g3">
        <RingProgress pct={(diasPassados/30)*100}><span className={diasRestantes<=3?"ring-quase":""}>{diasRestantes}d</span></RingProgress>
        <div className="flex1">
          <div style={{fontSize:12.5,color:"#101820",fontWeight:600}}>🔒 Próximo rendimento em {diasRestantes} dia{diasRestantes===1?"":"s"}</div>
          <div className="muted">Atualização mensal — evita registrar rendimento fora de época.</div>
        </div>
      </div>
    ) : (
      <div className="row g2">
        <input className="flex1" type="number" placeholder="Rendimento do mês (negativo = prejuízo)" value={valor} onChange={e=>{setValor(e.target.value);setErro("");}} onKeyDown={e=>e.key==="Enter"&&executar()} />
        <button className="btn-gold" onClick={executar}>Registrar</button>
      </div>
    )}
    {erro && <p style={{color:"#A13D3D",fontSize:12,marginTop:6}}>⚠️ {erro}</p>}
  </div>;
}

/* ===================== app ===================== */
const dadosVazios = { transactions:[], metasFinanceiras:[], metasMateriais:[], mensalidades:[], investimentos:[], orcamentos:{} };

function LivroCaixa() {
  const [perfis, setPerfis] = useState([]);
  const [perfilAtivo, setPerfilAtivoRaw] = useState(null);
  const [perfisProntos, setPerfisProntos] = useState(false);
  const [data,setData] = useState(null);
  const [loading,setLoading] = useState(true);
  const [tab,setTab] = useState("visao");
  const [saveState,setSaveState] = useState("idle");
  const [lastSaved,setLastSaved] = useState(null);
  const [somAtivo, setSomAtivo] = useState(somLigado);
  const firstLoad = useRef(true);
  const dataRef = useRef(null);
  dataRef.current = data;
  const fileInputRef = useRef(null);

  const setPerfilAtivo = (id) => { try{ localStorage.setItem(PERFIL_ATIVO_KEY, id); }catch(e){} setPerfilAtivoRaw(id); setTab("visao"); };

  useEffect(()=>{
    (async ()=>{
      const { perfis: p, ativo } = await carregarPerfis();
      setPerfis(p); setPerfilAtivoRaw(ativo); setPerfisProntos(true);
    })();
  },[]);

  useEffect(()=>{
    const onClick = (e) => { if (e.target.closest("button")) playClickPop(); };
    const onHover = (e) => { if (e.target.closest("button, .card, .tab-btn")) playHoverTick(); };
    const onTouchStart = () => { getAudioCtx(); }; // iOS só libera áudio dentro de um gesto de toque real
    document.addEventListener("click", onClick);
    document.addEventListener("mouseover", onHover);
    document.addEventListener("touchstart", onTouchStart, { once:true, passive:true });
    return () => { document.removeEventListener("click", onClick); document.removeEventListener("mouseover", onHover); document.removeEventListener("touchstart", onTouchStart); };
  },[]);

  useEffect(()=>{
    if (!perfilAtivo) return;
    setLoading(true); firstLoad.current = true;
    (async ()=>{
      let base = {...dadosVazios};
      try { const res = await storage.get(chaveDados(perfilAtivo)); if (res && res.value) base = {...dadosVazios, ...JSON.parse(res.value)}; } catch(e){}
      const processado = processarCobrancasAutomaticas(base);
      if (processado.mudou) {
        firstLoad.current = false;
        setTimeout(()=> toast(true, `💳 Cobrança automática: ${processado.resumo.join(", ")}.`), 500);
      }
      setData(processado.data); setLoading(false);
    })();
  },[perfilAtivo]);

  const salvar = useCallback(async (payload) => {
    setSaveState("saving");
    try {
      const result = await storage.set(chaveDados(perfilAtivo), JSON.stringify(payload));
      if (!result) throw new Error("sem resposta");
      setSaveState(result.synced ? "saved" : "saved-local");
      setLastSaved(new Date());
    } catch(e){ console.error(e); setSaveState("error"); }
  },[perfilAtivo]);

  useEffect(()=>{
    if (loading || !data) return;
    if (firstLoad.current) { firstLoad.current=false; return; }
    salvar(data);
  },[data, loading, salvar]);

  const saldo = useMemo(()=> !data?0:round2(data.transactions.reduce((a,t)=>a+(t.type==="ganho"?t.amount:-t.amount),0)),[data]);
  const saldoAnimado = useCountUp(saldo);
  const [delta, setDelta] = useState(null);
  const saldoPrevRef = useRef(saldo);
  useEffect(()=>{
    if (loading) return;
    const diff = round2(saldo - saldoPrevRef.current);
    if (diff !== 0) {
      const id = uid("delta");
      setDelta({ id, valor: diff });
      const t = setTimeout(()=> setDelta(d => d && d.id===id ? null : d), 2200);
      saldoPrevRef.current = saldo;
      return () => clearTimeout(t);
    }
    saldoPrevRef.current = saldo;
  },[saldo, loading]);
  const totalReservado = useMemo(()=>{ if(!data) return 0; const fin=data.metasFinanceiras.reduce((a,m)=>a+(m.saved||0),0); const mat=data.metasMateriais.reduce((a,m)=>a+(m.saved||0),0); return round2(fin+mat); },[data]);
  const totalInvestido = useMemo(()=> !data?0:round2(data.investimentos.reduce((a,i)=>a+(i.amount||0),0)),[data]);
  const patrimonioTotal = round2(saldo+totalReservado+totalInvestido);
  const totalMensal = useMemo(()=> !data?0:data.mensalidades.filter(m=>m.active).reduce((a,m)=>a+m.amount,0),[data]);
  const dadosGrafico = useMemo(()=>{
    if(!data) return [];
    const meses={};
    data.transactions.forEach(t=>{ const mes=t.date?.slice(0,7)||"—"; if(!meses[mes]) meses[mes]={mes,ganhos:0,gastos:0}; meses[mes][t.type==="ganho"?"ganhos":"gastos"]+=t.amount; });
    return Object.values(meses).sort((a,b)=>a.mes.localeCompare(b.mes)).slice(-6)
      .map(m=>({...m,label:new Date(m.mes+"-02").toLocaleDateString("pt-BR",{month:"short"})}));
  },[data]);
  const prioridades = useMemo(()=>{
    if (!data) return [];
    const hojeD = new Date(); hojeD.setHours(0,0,0,0);
    const itens = [];
    data.mensalidades.filter(m=>m.active).forEach(m=>{
      const d = m.proximaCobranca ? new Date(m.proximaCobranca+"T00:00:00") : proximaDataMensalidade(m);
      itens.push({ tipo:"Mensalidade", nome:m.name, valor:m.amount, dias: Math.round((d-hojeD)/86400000) });
    });
    data.metasMateriais.filter(m=>m.mode==="parcelado" && m.installmentsPaid<m.installments && m.dueDay).forEach(m=>{
      const d = proximaDataParcela(m); if(!d) return;
      itens.push({ tipo:"Parcela", nome:m.name, valor: valorProximaParcela(m), dias: Math.round((d-hojeD)/86400000) });
    });
    return itens.sort((a,b)=>a.dias-b.dias).slice(0,6);
  },[data]);

  const evolucaoPatrimonio = useMemo(()=> !data ? [] : calcularEvolucaoPatrimonio(data), [data]);

  if (!perfisProntos || loading || !data) return <div className="col g3" style={{minHeight:"100vh",justifyContent:"center",alignItems:"center",background:"#101820"}}><Logo size={40} /><span style={{fontSize:22}} className="spin">⏳</span></div>;

  const addTransacao = (t)=> setData(d=>({...d, transactions:[{...t,id:uid("t")},...d.transactions]}));
  const delTransacao = (id)=> setData(d=>({...d, transactions:d.transactions.filter(t=>t.id!==id)}));
  const addMetaFin = (m)=> setData(d=>({...d, metasFinanceiras:[...d.metasFinanceiras,{...m,id:uid("mf")}]}));
  const updMetaFin = (id,patch)=> setData(d=>({...d, metasFinanceiras:d.metasFinanceiras.map(m=>m.id===id?{...m,...patch}:m)}));
  const delMetaFinRaw = (id)=> setData(d=>({...d, metasFinanceiras:d.metasFinanceiras.filter(m=>m.id!==id)}));
  const addMetaMat = (m)=> setData(d=>({...d, metasMateriais:[...d.metasMateriais,{...m,id:uid("mm")}]}));
  const updMetaMat = (id,patch)=> setData(d=>({...d, metasMateriais:d.metasMateriais.map(m=>m.id===id?{...m,...patch}:m)}));
  const delMetaMatRaw = (id)=> setData(d=>({...d, metasMateriais:d.metasMateriais.filter(m=>m.id!==id)}));
  const addMensal = (m)=> setData(d=>({...d, mensalidades:[...d.mensalidades,{...m,id:uid("ms"),active:true, proximaCobranca: proximaDataMensalidade(m).toISOString().slice(0,10)}]}));
  const updMensal = (id,patch)=> setData(d=>({...d, mensalidades:d.mensalidades.map(m=>m.id===id?{...m,...patch}:m)}));
  const delMensal = (id)=> setData(d=>({...d, mensalidades:d.mensalidades.filter(m=>m.id!==id)}));
  const addInvestimento = (i)=> setData(d=>({...d, investimentos:[...d.investimentos,{...i,id:i.id||uid("inv")}]}));
  const updInvestimento = (id,patch)=> setData(d=>({...d, investimentos:d.investimentos.map(i=>i.id===id?{...i,...patch}:i)}));
  const delInvestimentoRaw = (id)=> setData(d=>({...d, investimentos:d.investimentos.filter(i=>i.id!==id)}));
  function definirOrcamento(categoria, valor){
    setData(d => {
      const orcamentos = {...(d.orcamentos||{})};
      if (valor===null) delete orcamentos[categoria]; else orcamentos[categoria]=valor;
      return {...d, orcamentos};
    });
  }

  function contribuir(item,valor,tipo){
    if(!valor||valor<=0) return {ok:false,msg:"Informe um valor válido."};
    if(valor>saldo) return {ok:false,msg:`Saldo insuficiente em caixa. Disponível: ${fmt(saldo)}.`};
    if (tipo==="financeira"){
      addTransacao({type:"gasto",amount:valor,category:"Reserva de meta",desc:`Reserva: ${item.name}`,date:hoje()});
      updMetaFin(item.id,{saved:round2((item.saved||0)+valor)});
      if ((item.saved||0)<item.target && (item.saved||0)+valor>=item.target) celebrar();
    } else if (tipo==="material"){
      addTransacao({type:"gasto",amount:valor,category:"Reserva de meta material",desc:`Reserva: ${item.name}`,date:hoje()});
      updMetaMat(item.id,{saved:round2((item.saved||0)+valor)});
      if ((item.saved||0)<item.price && (item.saved||0)+valor>=item.price) celebrar();
    } else { addTransacao({type:"gasto",amount:valor,category:"Aporte em investimento",desc:`Aporte: ${item.name}`,date:hoje()}); updInvestimento(item.id,{amount:round2((item.amount||0)+valor)}); }
    return {ok:true};
  }
  function resgatar(item,valor,tipo){
    const atual = tipo==="investimento" ? (item.amount||0) : (item.saved||0);
    if(!valor||valor<=0) return {ok:false,msg:"Informe um valor válido."};
    if(valor>atual) return {ok:false,msg:`Você tem apenas ${fmt(atual)} guardado aqui.`};
    if (tipo==="financeira"){ addTransacao({type:"ganho",amount:valor,category:"Resgate de meta",desc:`Resgate: ${item.name}`,date:hoje()}); updMetaFin(item.id,{saved:round2(item.saved-valor)}); }
    else if (tipo==="material"){ addTransacao({type:"ganho",amount:valor,category:"Resgate de meta material",desc:`Resgate: ${item.name}`,date:hoje()}); updMetaMat(item.id,{saved:round2(item.saved-valor)}); }
    else { addTransacao({type:"ganho",amount:valor,category:"Resgate de investimento",desc:`Resgate: ${item.name}`,date:hoje()}); updInvestimento(item.id,{amount:round2(item.amount-valor)}); }
    return {ok:true};
  }
  function excluirMetaFin(meta){ if(meta.saved>0) addTransacao({type:"ganho",amount:meta.saved,category:"Resgate de meta",desc:`Resgate por exclusão: ${meta.name}`,date:hoje()}); delMetaFinRaw(meta.id); }
  function excluirMetaMat(meta){ if(meta.saved>0) addTransacao({type:"ganho",amount:meta.saved,category:"Resgate de meta material",desc:`Resgate por exclusão: ${meta.name}`,date:hoje()}); delMetaMatRaw(meta.id); }
  function excluirInvestimento(inv){ if(inv.amount>0) addTransacao({type:"ganho",amount:inv.amount,category:"Resgate de investimento",desc:`Resgate por exclusão: ${inv.name}`,date:hoje()}); delInvestimentoRaw(inv.id); }
  function registrarRendimento(inv, valor){
    const novoValor = round2((inv.amount||0)+valor);
    if (novoValor<0) return {ok:false,msg:"Isso deixaria o investimento negativo — confira o valor."};
    updInvestimento(inv.id, { amount: novoValor, ultimoRendimento: hoje(), historico:[...(inv.historico||[]), {id:uid("rend"), valor, date:hoje()}] });
    toast(valor>=0, `${valor>=0?"Rendimento":"Prejuízo"} de ${fmt(Math.abs(valor))} registrado em "${inv.name}".`);
    return {ok:true};
  }

  function pagarParcela(meta){
    if (meta.installmentsPaid>=meta.installments) return {ok:false,msg:"Essa meta já está quitada."};
    const valor = valorProximaParcela(meta);
    if (valor>saldo) return {ok:false,msg:`Saldo insuficiente para a parcela de ${fmt(valor)}.`};
    addTransacao({type:"gasto",amount:valor,category:"Parcela de meta material",desc:`Parcela ${meta.installmentsPaid+1}/${meta.installments}: ${meta.name}`,date:hoje()});
    updMetaMat(meta.id,{saved:round2(meta.saved+valor), installmentsPaid:meta.installmentsPaid+1});
    if (meta.installmentsPaid+1>=meta.installments) celebrar();
    return {ok:true};
  }
  function quitarRestante(meta){
    const restante = round2(meta.price-meta.saved);
    if (restante<=0) return {ok:false,msg:"Essa meta já está quitada."};
    if (restante>saldo) return {ok:false,msg:`Saldo insuficiente. Faltam ${fmt(restante)}.`};
    addTransacao({type:"gasto",amount:restante,category:"Parcela de meta material",desc:`Quitação total: ${meta.name}`,date:hoje()});
    updMetaMat(meta.id,{saved:meta.price, installmentsPaid:meta.installments});
    celebrar();
    return {ok:true};
  }

  function exportarBackup(){
    const blob = new Blob([JSON.stringify(data,null,2)], {type:"application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `livro-caixa-backup-${hoje()}.json`; a.click();
    URL.revokeObjectURL(url);
  }
  function importarBackup(e){
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      try { const parsed = JSON.parse(ev.target.result); setData({...dadosVazios, ...parsed}); toast(true,"Backup importado com sucesso."); }
      catch(err){ toast(false,"Não consegui ler esse arquivo."); }
    };
    reader.readAsText(file);
    e.target.value = "";
  }

  async function criarPerfil(nome){
    const emoji = EMOJIS_PERFIL[perfis.length % EMOJIS_PERFIL.length];
    const novo = { id: uid("perfil"), name: nome||"Nova conta", emoji, criadoEm: hoje() };
    const atualizados = [...perfis, novo];
    setPerfis(atualizados);
    const r = await storage.set(PERFIS_KEY, JSON.stringify(atualizados));
    setPerfilAtivo(novo.id);
    toast(true, `Conta "${novo.name}" criada${r && r.synced ? "" : " (só neste aparelho por enquanto)"}.`);
  }
  async function renomearPerfil(id, nome){
    const atualizados = perfis.map(p=>p.id===id?{...p,name:nome}:p);
    setPerfis(atualizados); await storage.set(PERFIS_KEY, JSON.stringify(atualizados));
  }
  async function excluirPerfil(id){
    if (perfis.length<=1) { toast(false,"Você precisa manter pelo menos uma conta."); return; }
    if (!window.confirm("Excluir essa conta e todos os dados dela? Isso não pode ser desfeito.")) return;
    const atualizados = perfis.filter(p=>p.id!==id);
    setPerfis(atualizados);
    await storage.set(PERFIS_KEY, JSON.stringify(atualizados));
    try { await storage.remove(chaveDados(id)); } catch(e){}
    if (perfilAtivo===id) setPerfilAtivo(atualizados[0].id);
    toast(true,"Conta excluída.");
  }
  function resetarPerfilAtual(){
    if (!window.confirm("Resetar essa conta apaga todos os lançamentos, metas e investimentos dela. Confirma?")) return;
    setData({...dadosVazios});
    toast(true,"Conta resetada.");
  }

  const tabs = [
    {id:"visao",label:"Visão Geral",icon:"📊"},
    {id:"lancamentos",label:"Lançamentos",icon:"💸"},
    {id:"orcamento",label:"Orçamento",icon:"🧾"},
    {id:"metasfin",label:"Metas Financeiras",icon:"🎯"},
    {id:"metasmat",label:"Metas Materiais",icon:"🛍️"},
    {id:"investimentos",label:"Investimentos",icon:"📈"},
    {id:"mensal",label:"Mensalidades",icon:"🔁"},
    {id:"noticias",label:"Notícias",icon:"📰"},
    {id:"config",label:"Configurações",icon:"⚙️"},
  ];

  return <div style={{minHeight:"100vh",position:"relative"}}>
    <div className="ambient"><div className="blob blob1"/><div className="blob blob2"/><div className="blob blob3"/></div>
    <div className="app-shell" style={{maxWidth:800, margin:"0 auto", padding:"24px 16px"}}>

      <div style={{borderBottom:"1px solid rgba(239,234,218,.14)", paddingBottom:22, marginBottom:24}}>
        <div className="row-between" style={{marginBottom:8}}>
          <div className="row g2"><Logo size={26} /><span className="serif" style={{color:"#EFEADA",fontSize:16,fontWeight:700}}>Livro-Caixa</span><span className="mono" style={{color:"#B08D3F",fontSize:10,letterSpacing:2,marginLeft:2}}>PESSOAL</span></div>
          <div className="row g2" style={{fontSize:12,color:"#7A8471"}}>
            {saveState==="saving" && <><Spinner/> sincronizando…</>}
            {saveState==="saved" && <span style={{color:"#5C9E82"}}>☁️ sincronizado às {lastSaved?.toLocaleTimeString("pt-BR",{hour:"2-digit",minute:"2-digit",second:"2-digit"})}</span>}
            {saveState==="saved-local" && <span style={{color:"#B08D3F"}}>💾 salvo só neste aparelho (sem internet)</span>}
            {saveState==="error" && <span style={{color:"#D07575"}}>⚠️ não salvou</span>}
          </div>
        </div>

        <div className="row-between wrap g2" style={{marginBottom:4}}>
          <div>
            <h1 className="serif" style={{fontSize:30,color:"#EFEADA",margin:0}}>Saldo disponível</h1>
            <div className="title-underline"></div>
          </div>
          <select className="profile-select" value={perfilAtivo} onChange={(e)=>{ if(e.target.value==="__novo__"){ const nome=window.prompt("Nome da nova conta (ex: Filho, Reserva conjunta):"); if(nome && nome.trim()) criarPerfil(nome.trim()); } else setPerfilAtivo(e.target.value); }}>
            {perfis.map(p=><option key={p.id} value={p.id}>{p.emoji} {p.name}</option>)}
            <option value="__novo__">➕ Nova conta…</option>
          </select>
        </div>

        <div className="balance-wrap">
          <div className="mono balance-glow" style={{fontSize:38,fontWeight:700,color: saldo>=0?"#6FB596":"#D07575", marginTop:12}}>
            {fmt(saldoAnimado)}
            {delta && <span key={delta.id} className={"delta-pill "+(delta.valor>=0?"delta-up":"delta-down")}>{delta.valor>=0?"▲":"▼"} {fmt(Math.abs(delta.valor))}</span>}
          </div>
        </div>
        <div className="row wrap g5" style={{marginTop:12,rowGap:4}}>
          <div style={{fontSize:12,color:"#9B9480"}}>Reservado em metas <span className="mono" style={{color:"#EFEADA",marginLeft:4}}>{fmt(totalReservado)}</span></div>
          <div style={{fontSize:12,color:"#9B9480"}}>Investido <span className="mono" style={{color:"#EFEADA",marginLeft:4}}>{fmt(totalInvestido)}</span></div>
          <div style={{fontSize:12,color:"#9B9480"}}>Patrimônio total <span className="mono" style={{color:"#EFEADA",marginLeft:4}}>{fmt(patrimonioTotal)}</span></div>
          {totalMensal>0 && <div style={{fontSize:12,color:"#9B9480"}}>Mensalidades ativas <span className="mono" style={{color:"#EFEADA",marginLeft:4}}>{fmt(totalMensal)}/mês</span></div>}
        </div>

        {patrimonioTotal>0 && <DistribuicaoBar saldo={saldo} totalReservado={totalReservado} totalInvestido={totalInvestido} patrimonioTotal={patrimonioTotal} />}
      </div>

      <div className="tabs" style={{marginBottom:20}}>
        {tabs.map(t => <button key={t.id} className={"tab-btn"+(tab===t.id?" active":"")} onClick={()=>setTab(t.id)}>{t.icon} {t.label}</button>)}
      </div>

      <div className="tab-content" key={tab+perfilAtivo}>
        {tab==="visao" && <VisaoGeral data={data} dadosGrafico={dadosGrafico} prioridades={prioridades} evolucaoPatrimonio={evolucaoPatrimonio} totalInvestido={totalInvestido} />}
        {tab==="lancamentos" && <Lancamentos data={data} addTransacao={addTransacao} delTransacao={delTransacao} />}
        {tab==="orcamento" && <Orcamento data={data} definirOrcamento={definirOrcamento} />}
        {tab==="metasfin" && <MetasFinanceiras metas={data.metasFinanceiras} saldo={saldo} totalInvestido={totalInvestido} add={addMetaFin} contribuir={contribuir} resgatar={resgatar} excluir={excluirMetaFin} />}
        {tab==="metasmat" && <MetasMateriais metas={data.metasMateriais} saldo={saldo} add={addMetaMat} contribuir={contribuir} resgatar={resgatar} excluir={excluirMetaMat} pagarParcela={pagarParcela} quitarRestante={quitarRestante} />}
        {tab==="investimentos" && <Investimentos investimentos={data.investimentos} saldo={saldo} patrimonioTotal={patrimonioTotal} add={addInvestimento} contribuir={contribuir} resgatar={resgatar} excluir={excluirInvestimento} registrarRendimento={registrarRendimento} />}
        {tab==="mensal" && <Mensalidades lista={data.mensalidades} add={addMensal} upd={updMensal} del={delMensal} />}
        {tab==="noticias" && <Noticias />}
        {tab==="config" && <Configuracoes perfis={perfis} perfilAtivo={perfilAtivo} criarPerfil={criarPerfil} renomearPerfil={renomearPerfil} excluirPerfil={excluirPerfil} resetarPerfilAtual={resetarPerfilAtual}
          exportarBackup={exportarBackup} importarBackup={importarBackup} fileInputRef={fileInputRef} somAtivo={somAtivo} setSomAtivo={setSomAtivo} />}
      </div>
      <div className="app-footer">📒 Livro-Caixa Pessoal — seu dinheiro, suas regras.</div>
    </div>
    <ToastContainer />
  </div>;
}

