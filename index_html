async function buscarCotacoes(){
  const resp = await fetch("https://economia.awesomeapi.com.br/last/USD-BRL,EUR-BRL,GBP-BRL,BTC-BRL,ETH-BRL");
  const json = await resp.json();
  const usdBrl = parseFloat(json.USDBRL.bid);
  return [
    { label:"Dólar", valor: usdBrl, pct: parseFloat(json.USDBRL.pctChange), moeda:"BRL" },
    { label:"Euro", valor: parseFloat(json.EURBRL.bid), pct: parseFloat(json.EURBRL.pctChange), moeda:"BRL" },
    { label:"Libra", valor: parseFloat(json.GBPBRL.bid), pct: parseFloat(json.GBPBRL.pctChange), moeda:"BRL" },
    { label:"Bitcoin", valor: parseFloat(json.BTCBRL.bid)/usdBrl, pct: parseFloat(json.BTCBRL.pctChange), moeda:"USD" },
    { label:"Ethereum", valor: parseFloat(json.ETHBRL.bid)/usdBrl, pct: parseFloat(json.ETHBRL.pctChange), moeda:"USD" },
  ];
}
function fmtMoeda(v, moeda){
  return v.toLocaleString(moeda==="USD"?"en-US":"pt-BR", { style:"currency", currency: moeda });
}

function TickerCotacoes(){
  const [cotacoes, setCotacoes] = useState(null);
  const [erro, setErro] = useState(false);

  useEffect(()=>{
    (async () => {
      try {
        let cache = null;
        try { cache = JSON.parse(localStorage.getItem("livro-caixa-cotacoes-cache-v2")||"null"); } catch(e){}
        if (cache && (Date.now()-cache.ts < 10*60*1000)) { setCotacoes(cache.dados); return; }
        const dados = await buscarCotacoes();
        try { localStorage.setItem("livro-caixa-cotacoes-cache-v2", JSON.stringify({ts:Date.now(), dados})); } catch(e){}
        setCotacoes(dados);
      } catch(e){ setErro(true); }
    })();
  },[]);

  if (erro || !cotacoes) return null;
  const itens = [...cotacoes, ...cotacoes, ...cotacoes];

  return (
    <div className="ticker-wrap">
      <div className="ticker-track">
        {itens.map((c,i)=>(
          <span key={i} className="ticker-item">
            <strong>{c.label}</strong> {fmtMoeda(c.valor, c.moeda)}
            <span style={{color: c.pct>=0?"#6FB596":"#D07575"}}>{c.pct>=0?"▲":"▼"} {Math.abs(c.pct).toFixed(2)}%</span>
          </span>
        ))}
      </div>
    </div>
  );
}

function Noticias(){
  const [noticias, setNoticias] = useState(null);
  const [carregando, setCarregando] = useState(true);
  const [erro, setErro] = useState(false);

  async function carregar(forcar){
    setCarregando(true); setErro(false);
    try {
      let cache = null;
      try { cache = JSON.parse(localStorage.getItem("livro-caixa-noticias-cache")||"null"); } catch(e){}
      if (!forcar && cache && (Date.now()-cache.ts < 20*60*1000)) { setNoticias(cache.dados); setCarregando(false); return; }
      const dados = await buscarNoticias();
      if (!dados.length) throw new Error("vazio");
      try { localStorage.setItem("livro-caixa-noticias-cache", JSON.stringify({ts:Date.now(), dados})); } catch(e){}
      setNoticias(dados);
    } catch(e){ setErro(true); }
    setCarregando(false);
  }
  useEffect(()=>{ carregar(false); },[]);

  return <div className="stack">
    <Card>
      <div className="row-between" style={{marginBottom:8}}>
        <SectionTitle sub="Manchetes de economia, direto das fontes.">📰 Notícias do mercado</SectionTitle>
        <button className="btn-ghost" style={{fontSize:12}} onClick={()=>carregar(true)}>🔄 Atualizar</button>
      </div>
      {carregando && <p className="muted"><span className="spin">⏳</span> Buscando notícias…</p>}
      {!carregando && erro && <div>
        <p className="muted" style={{marginBottom:8}}>Não consegui buscar as notícias agora. Aqui vão links diretos:</p>
        <div className="stack-sm">{LINKS_CURADOS.map(l=>(<a key={l.url} href={l.url} target="_blank" rel="noopener" className="news-link row-between">{l.nome} <span>↗</span></a>))}</div>
      </div>}
      {!carregando && !erro && noticias && <div className="stack-sm">
        {noticias.map((n,i)=>(<a key={i} href={n.link} target="_blank" rel="noopener" className="news-link">
          <div style={{fontWeight:600,fontSize:14}}>{n.titulo}</div>
          <div className="muted">{n.fonte} · {new Date(n.data).toLocaleDateString("pt-BR")}</div>
        </a>))}
      </div>}
    </Card>
    <TickerCotacoes />
  </div>;
}

/* ===================== Configurações ===================== */
function Configuracoes({perfis, perfilAtivo, criarPerfil, renomearPerfil, excluirPerfil, resetarPerfilAtual, exportarBackup, importarBackup, fileInputRef, somAtivo, setSomAtivo}) {
  const [config, setConfigState] = useState(()=>lerConfig());
  const [nomeNovo, setNomeNovo] = useState("");
  const [editandoId, setEditandoId] = useState(null);
  const [nomeEdit, setNomeEdit] = useState("");
  const [pinAtual, setPinAtual] = useState(()=>{ try{ return localStorage.getItem(PIN_KEY)||""; }catch(e){ return ""; } });
  const [novoPin, setNovoPin] = useState("");

  const definirPin = () => {
    if (novoPin.length<4) { toast(false,"O PIN precisa ter pelo menos 4 dígitos."); return; }
    const h = hashSimples(novoPin);
    try{ localStorage.setItem(PIN_KEY, h); }catch(e){}
    setPinAtual(h); setNovoPin("");
    toast(true,"PIN definido — vai pedir na próxima vez que abrir o app.");
  };
  const removerPin = () => {
    try{ localStorage.removeItem(PIN_KEY); }catch(e){}
    setPinAtual(""); toast(true,"PIN removido.");
  };

  return <div className="stack">
    <Card>
      <SectionTitle sub="Cada conta guarda seus próprios lançamentos, metas e investimentos — separado das outras. Ótimo pra cuidar da economia de outra pessoa também.">👥 Contas</SectionTitle>
      <div className="stack-sm">
        {perfis.map(p=>(
          <div key={p.id} className="row g2" style={{padding:"8px 0",borderBottom:"1px solid rgba(16,24,32,.08)"}}>
            <span style={{fontSize:18}}>{p.emoji}</span>
            {editandoId===p.id ? (
              <input className="flex1" value={nomeEdit} onChange={e=>setNomeEdit(e.target.value)} onKeyDown={e=>{ if(e.key==="Enter"){ renomearPerfil(p.id,nomeEdit); setEditandoId(null); } }} />
            ) : (
              <span className="flex1" style={{fontWeight: p.id===perfilAtivo?700:400}}>{p.name}{p.id===perfilAtivo && <span className="muted"> (ativa)</span>}</span>
            )}
            {editandoId===p.id ? (
              <button className="btn-success" style={{fontSize:12}} onClick={()=>{ renomearPerfil(p.id,nomeEdit); setEditandoId(null); }}>Salvar</button>
            ) : (
              <button className="icon-btn" onClick={()=>{ setEditandoId(p.id); setNomeEdit(p.name); }}>✏️</button>
            )}
            {perfis.length>1 && <button className="icon-btn" onClick={()=>excluirPerfil(p.id)}>🗑️</button>}
          </div>
        ))}
      </div>
      <div className="row g2" style={{marginTop:12}}>
        <input className="flex1" placeholder="Nome da nova conta (ex: Filho, Reserva conjunta)" value={nomeNovo} onChange={e=>setNomeNovo(e.target.value)} onKeyDown={e=>{ if(e.key==="Enter" && nomeNovo.trim()){ criarPerfil(nomeNovo.trim()); setNomeNovo(""); } }} />
        <button className="btn-primary" onClick={()=>{ if(nomeNovo.trim()){ criarPerfil(nomeNovo.trim()); setNomeNovo(""); } }}>Criar conta</button>
      </div>
      <button className="btn-danger wfull" style={{marginTop:12}} onClick={resetarPerfilAtual}>🔄 Resetar a conta atual (apaga tudo dela)</button>
    </Card>

    <Card>
      <SectionTitle>🔊 Preferências</SectionTitle>
      <button className="btn-ghost wfull" onClick={()=>setSomAtivo(alternarSom())}>{somAtivo?"🔊 Som ligado":"🔇 Som desligado"}</button>
    </Card>

    <Card>
      <SectionTitle sub="Trava simples pra evitar que alguém abra seu app casualmente neste aparelho. Não é criptografia forte, é só uma tela de bloqueio.">🔐 PIN de acesso</SectionTitle>
      {pinAtual ? (
        <div>
          <p className="muted" style={{marginBottom:8}}>PIN ativo neste aparelho.</p>
          <button className="btn-danger wfull" onClick={removerPin}>Remover PIN</button>
        </div>
      ) : (
        <div className="row g2">
          <input className="flex1" type="password" inputMode="numeric" placeholder="Criar PIN (4-6 dígitos)" value={novoPin} onChange={e=>setNovoPin(e.target.value.replace(/\D/g,"").slice(0,6))} onKeyDown={e=>e.key==="Enter"&&definirPin()} />
          <button className="btn-gold" onClick={definirPin}>Definir</button>
        </div>
      )}
    </Card>

    <Card>
      <SectionTitle sub="Guarde uma cópia de segurança fora do navegador, ou leve seus dados pra outro computador.">💾 Backup</SectionTitle>
      <div className="row g2">
        <button className="btn-ghost flex1" onClick={exportarBackup}>⬇️ Exportar backup</button>
        <button className="btn-ghost flex1" onClick={()=>fileInputRef.current.click()}>⬆️ Importar backup</button>
        <input ref={fileInputRef} type="file" accept="application/json" style={{display:"none"}} onChange={importarBackup} />
      </div>
    </Card>

    <Card>
      <SectionTitle sub="Opcional: cole sua própria chave da API da Anthropic pra ativar respostas de uma IA de verdade no Consultor. Sem chave, o Consultor usa uma análise automática dos seus números — funciona sem custo nenhum.">🤖 IA real (opcional, avançado)</SectionTitle>
      <p className="muted" style={{marginBottom:8}}>Sua chave fica salva só neste navegador — nunca é enviada pra mim, só direto pra API da Anthropic. O uso gera custo na sua própria conta. Não compartilhe esse arquivo com a chave preenchida.</p>
      <input className="wfull" style={{marginBottom:8}} type="password" placeholder="sk-ant-..." value={config.apiKey} onChange={e=>setConfigState({...config, apiKey:e.target.value})} />
      <input className="wfull" style={{marginBottom:8}} placeholder="Modelo (padrão: claude-sonnet-5)" value={config.modelo} onChange={e=>setConfigState({...config, modelo:e.target.value})} />
      <button className="btn-gold wfull" onClick={()=>{ salvarConfig(config); toast(true,"Configuração salva."); }}>Salvar</button>
    </Card>
  </div>;
}

ReactDOM.createRoot(document.getElementById("root")).render(<LockGate><LivroCaixa /></LockGate>);
