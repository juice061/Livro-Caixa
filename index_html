function Lancamentos({data, addTransacao, delTransacao}) {
  const [form,setForm] = useState({type:"gasto",amount:"",category:CATEGORIAS_GASTO[0],desc:"",date:hoje()});
  const [filtro,setFiltro] = useState("todos");
  const [filtroCategoria,setFiltroCategoria] = useState("todas");
  const [anexo, setAnexo] = useState(null);
  const [anexoPreview, setAnexoPreview] = useState(null);
  const [verFoto, setVerFoto] = useState(null);
  const fileRef = useRef(null);
  const categoriasAtuais = form.type==="gasto"?CATEGORIAS_GASTO:CATEGORIAS_GANHO;

  const escolherArquivo = async (e) => {
    const file = e.target.files[0]; if(!file) return;
    try { const comprimida = await comprimirImagem(file); setAnexo(comprimida); setAnexoPreview(comprimida); }
    catch(err) { toast(false,"Não consegui processar essa imagem."); }
    e.target.value = "";
  };

  const submit = () => {
    if(!form.amount) return;
    const valor = parseFloat(form.amount);
    addTransacao({...form, amount:valor, anexo});
    if (form.type==="gasto" && data.orcamentos && data.orcamentos[form.category]) {
      const mesAtual = hoje().slice(0,7);
      const gastoAtual = data.transactions.filter(t=>t.type==="gasto"&&t.category===form.category&&t.date.slice(0,7)===mesAtual).reduce((a,t)=>a+t.amount,0) + valor;
      const limite = data.orcamentos[form.category];
      if (gastoAtual > limite) setTimeout(()=>toast(false, `⚠️ Passou do orçamento de ${form.category}: ${fmt(gastoAtual)} / ${fmt(limite)}.`), 400);
      else if (gastoAtual > limite*0.8) setTimeout(()=>toast(true, `Atenção: já usou ${Math.round((gastoAtual/limite)*100)}% do orçamento de ${form.category}.`), 400);
    }
    setForm({...form, amount:"", desc:""}); setAnexo(null); setAnexoPreview(null);
    toast(true,"Lançamento registrado.");
  };

  const lista = data.transactions.filter(t=>(filtro==="todos"||t.type===filtro) && (filtroCategoria==="todas"||t.category===filtroCategoria)).sort((a,b)=>(b.date||"").localeCompare(a.date||""));
  const categoriasComGasto = [...new Set(data.transactions.map(t=>t.category))].sort();
  const totalFiltrado = lista.reduce((a,t)=>a+t.amount,0);

  return <div className="stack">
    <Card>
      <SectionTitle sub='Precisão total pelas abas — anexe uma foto do comprovante se quiser guardar.'>Novo lançamento</SectionTitle>
      <div className="row g2" style={{marginBottom:12}}>
        {["gasto","ganho"].map(tp=>(
          <button key={tp} className="flex1" style={{background: form.type===tp?(tp==="gasto"?"#A13D3D":"#3A6B54"):"rgba(16,24,32,.06)", color: form.type===tp?"#fff":"#101820"}}
            onClick={()=>setForm({...form,type:tp,category: tp==="gasto"?CATEGORIAS_GASTO[0]:CATEGORIAS_GANHO[0]})}>{tp==="gasto"?"Gasto":"Ganho"}</button>
        ))}
      </div>
      <div className="grid2" style={{marginBottom:8}}>
        <input type="number" placeholder="Valor" value={form.amount} onChange={e=>setForm({...form,amount:e.target.value})} />
        <select value={form.category} onChange={e=>setForm({...form,category:e.target.value})}>{categoriasAtuais.map(c=><option key={c} value={c}>{c}</option>)}</select>
      </div>
      <input className="wfull" style={{marginBottom:8}} placeholder="Descrição (opcional)" value={form.desc} onChange={e=>setForm({...form,desc:e.target.value})} />
      <div className="row g2" style={{marginBottom:8}}>
        <button className="btn-ghost" onClick={()=>fileRef.current.click()}>📎 {anexoPreview? "Trocar foto" : "Anexar comprovante"}</button>
        {anexoPreview && <img src={anexoPreview} style={{height:38,width:38,borderRadius:8,objectFit:"cover"}} />}
        {anexoPreview && <IconBtn onClick={()=>{setAnexo(null);setAnexoPreview(null);}} title="Remover foto">✖️</IconBtn>}
        <input ref={fileRef} type="file" accept="image/*" style={{display:"none"}} onChange={escolherArquivo} />
      </div>
      <div className="row g2"><input className="flex1" type="date" value={form.date} onChange={e=>setForm({...form,date:e.target.value})} /><button className="btn-primary" onClick={submit}>Registrar</button></div>
    </Card>
    <div>
      <div className="row-between wrap g2" style={{marginBottom:8}}>
        <SectionTitle light>Extrato</SectionTitle>
        <div className="row g2 wrap">
          <div className="row g1">{["todos","gasto","ganho"].map(f=>(
            <button key={f} style={{padding:"4px 10px",fontSize:12,background: filtro===f?"#B08D3F":"rgba(239,234,218,.08)", color: filtro===f?"#101820":"#A8A18C"}} onClick={()=>setFiltro(f)}>{f==="todos"?"Todos":f==="gasto"?"Gastos":"Ganhos"}</button>
          ))}</div>
          <select value={filtroCategoria} onChange={e=>setFiltroCategoria(e.target.value)} style={{fontSize:12,padding:"4px 8px"}}>
            <option value="todas">Todas as categorias</option>
            {categoriasComGasto.map(c=><option key={c} value={c}>{c}</option>)}
          </select>
        </div>
      </div>
      {filtroCategoria!=="todas" && <p className="muted" style={{textAlign:"right",marginBottom:6}}>Total em <strong>{filtroCategoria}</strong>: <span className="mono" style={{color:"#EFEADA"}}>{fmt(totalFiltrado)}</span></p>}
      <Card style={{padding:8}}>
        {lista.length===0 && <p className="muted" style={{padding:12}}>Nenhum lançamento ainda.</p>}
        {lista.map(t=>(
          <div key={t.id} className="row g3" style={{padding:"8px",borderBottom:"1px solid rgba(16,24,32,.06)"}}>
            <div style={{background: t.type==="ganho"?"rgba(58,107,84,.14)":"rgba(161,61,61,.14)", padding:6, borderRadius:6}}>{EMOJI_CATEGORIA[t.category]||"•"}</div>
            <div className="flex1" style={{minWidth:0}}><div style={{fontSize:13,fontWeight:500}}>{t.desc||t.category}</div><div className="muted">{t.category} · {t.date}</div></div>
            {t.anexo && <img src={t.anexo} onClick={()=>setVerFoto(t.anexo)} title="Ver comprovante" style={{width:30,height:30,borderRadius:6,objectFit:"cover",cursor:"pointer"}} />}
            <div className="mono" style={{fontSize:13,fontWeight:700,color: t.type==="ganho"?"#3A6B54":"#A13D3D"}}>{t.type==="ganho"?"+":"−"}{fmt(t.amount)}</div>
            <IconBtn onClick={()=>delTransacao(t.id)} title="Excluir">🗑️</IconBtn>
          </div>
        ))}
      </Card>
    </div>
    {verFoto && (
      <div onClick={()=>setVerFoto(null)} style={{position:"fixed",inset:0,background:"rgba(13,20,31,.88)",zIndex:9999,display:"flex",alignItems:"center",justifyContent:"center",padding:24,cursor:"zoom-out"}}>
        <img src={verFoto} style={{maxWidth:"100%",maxHeight:"100%",borderRadius:10,boxShadow:"0 20px 60px rgba(0,0,0,.5)"}} />
      </div>
    )}
  </div>;
}

