/* ===================== interpretação de texto livre (usada pelo Consultor) ===================== */
function parseRapido(texto){
  const t = texto.toLowerCase();
  const amount = extrairValor(texto);
  const isGanho = /(ganhei|recebi|entrou|caiu|salário|salario|pagamento recebido)/.test(t);
  const type = isGanho ? "ganho" : "gasto";
  const mapa = {
    "Alimentação":["mercado","supermercado","comida","restaurante","ifood","lanche","padaria"],
    "Transporte":["uber","gasolina","combustível","combustivel","99","ônibus","onibus","metrô","metro"],
    "Moradia":["aluguel","condomínio","condominio","luz","água","agua","internet","energia"],
    "Lazer":["cinema","show","viagem","bar","festa","streaming"],
    "Saúde":["farmácia","farmacia","remédio","remedio","médico","medico","academia"],
    "Educação":["curso","faculdade","livro","escola"],
    "Salário":["salário","salario"],
    "Freelance":["freela","freelance","bico"],
    "Investimentos":["dividendo","rendimento","investimento"],
  };
  let category = "Outros";
  for (const [cat, palavras] of Object.entries(mapa)) if (palavras.some(p=>t.includes(p))) { category = cat; break; }
  return amount ? { id: uid("t"), type, amount, category, desc: texto.trim(), date: hoje() } : null;
}
function extrairValor(texto){
  let t = texto.toLowerCase();
  t = t.replace(/(\d+[.,]?\d*)\s*mil\b/g,(_,p1)=>String(parseFloat(p1.replace(",","."))*1000));
  t = t.replace(/(\d+[.,]?\d*)\s*k\b/g,(_,p1)=>String(parseFloat(p1.replace(",","."))*1000));
  const m = t.match(/(\d+[.,]?\d*)/);
  return m ? parseFloat(m[1].replace(",",".")) : null;
}
function extrairData(texto){
  const t = texto.toLowerCase();
  const dm = t.match(/(\d{1,2})\/(\d{1,2})\/(\d{2,4})/);
  if (dm){ let [,d,mo,y]=dm; if(y.length===2) y="20"+y; return `${y}-${String(mo).padStart(2,"0")}-${String(d).padStart(2,"0")}`; }
  const meses = {janeiro:1,fevereiro:2,"março":3,marco:3,abril:4,maio:5,junho:6,julho:7,agosto:8,setembro:9,outubro:10,novembro:11,dezembro:12};
  const mm = t.match(/(janeiro|fevereiro|março|marco|abril|maio|junho|julho|agosto|setembro|outubro|novembro|dezembro)(?:\s+de)?\s*(\d{4})?/);
  if (mm){ const mes=meses[mm[1]]; const ano=mm[2]||new Date().getFullYear(); const ultimo=new Date(ano,mes,0).getDate(); return `${ano}-${String(mes).padStart(2,"0")}-${String(ultimo).padStart(2,"0")}`; }
  const yy = t.match(/\b(20\d{2})\b/);
  if (yy) return `${yy[1]}-12-31`;
  return "";
}
function encontrarItem(texto, lista){
  const t = texto.toLowerCase();
  let melhor=null, score=0;
  (lista||[]).forEach(item=>{ const nome=(item.name||"").toLowerCase(); if(nome && t.includes(nome) && nome.length>score){melhor=item; score=nome.length;} });
  return melhor;
}
function limpar(texto, palavras){
  let s = " "+texto+" ";
  palavras.forEach(p=>{ s = s.replace(new RegExp(`\\b${p}\\b`,"gi")," "); });
  s = s.replace(/r\$\s*/gi," ").replace(/\d+[.,]?\d*\s*(mil|k)?\b/gi," ").replace(/\s+/g," ").trim();
  return s;
}
const V_CRIAR=["criar","crie","cria","nova meta","quero","meta de","meta"];
const V_GUARDAR=["guardar","guardei","depositar","depositei","colocar","coloquei","adicionar","adicionei","separar","separei","poupar","poupei"];
const V_RESGATAR=["resgatar","resgatei","tirar","tirei","retirar","retirei","sacar","saquei"];

function parseMetaFinanceira(texto, metas){
  const t = texto.toLowerCase();
  const valor = extrairValor(texto);
  const isResgate = V_RESGATAR.some(v=>t.includes(v));
  const isGuardar = !isResgate && V_GUARDAR.some(v=>t.includes(v));
  if (isResgate || isGuardar){
    const item = encontrarItem(texto, metas);
    if (!item) return {ok:false,msg:null};
    if (!valor) return {ok:false,msg:"Não identifiquei o valor."};
    return {ok:true, action:isResgate?"resgatar":"contribuir", item, valor};
  }
  if (!/(meta|juntar|guardar dinheiro)/.test(t) || !valor) return {ok:false,msg:null};
  const deadline = extrairData(texto);
  const linked = /(investid|investimento)/.test(t);
  let nome = limpar(texto,[...V_CRIAR,"até","ate","de","reais","mil","investido","investidos","investimento"]);
  if (!nome) nome = "Nova meta";
  return {ok:true, action:"criar", nome, valor, deadline, linked};
}

const V_PARCELAR=["parcelar","parcelado","financiar","financiado"];
const V_PAGARPARC=["pagar a parcela","pagar parcela","paguei a parcela","paguei parcela"];
const V_QUITAR=["quitar","quitação","pagar tudo","pagar o restante","pagar restante"];

function parseMetaMaterial(texto, metas){
  const t = texto.toLowerCase();
  const valor = extrairValor(texto);
  if (V_QUITAR.some(v=>t.includes(v))){
    const item = encontrarItem(texto, metas);
    if (!item) return {ok:false,msg:null};
    return {ok:true, action:"quitar", item};
  }
  if (V_PAGARPARC.some(v=>t.includes(v))){
    const item = encontrarItem(texto, metas);
    if (!item) return {ok:false,msg:null};
    return {ok:true, action:"pagarParcela", item};
  }
  const isResgate = V_RESGATAR.some(v=>t.includes(v));
  const isGuardar = !isResgate && V_GUARDAR.some(v=>t.includes(v));
  if ((isResgate || isGuardar) && encontrarItem(texto, metas)){
    const item = encontrarItem(texto, metas);
    if (item.mode==="parcelado") return {ok:false,msg:'Esse item é parcelado — use "pagar parcela" ou "quitar".'};
    if (!valor) return {ok:false,msg:"Não identifiquei o valor."};
    return {ok:true, action:isResgate?"resgatar":"contribuir", item, valor};
  }
  if (!/(comprar|parcelar|financiar)/.test(t) || !valor) return {ok:false,msg:null};
  const pm = t.match(/em\s*(\d+)\s*x/) || t.match(/(\d+)\s*x\b/) || t.match(/(\d+)\s*parcelas/);
  const isParcelado = V_PARCELAR.some(v=>t.includes(v)) || !!pm;
  const priority = /(urgente|prioridade alta)/.test(t) ? "alta" : /(prioridade baixa|sem pressa)/.test(t) ? "baixa" : "media";
  let nome = limpar(texto,["quero comprar","comprar","criar","crie","nova meta","parcelar","parcelado","financiar","em","x","parcelas","de","por","reais","mil","urgente"]);
  if (!nome) nome = "Novo item";
  if (isParcelado){ const parcelas = pm ? Math.max(1,parseInt(pm[1])) : 3; return {ok:true, action:"criarParcelado", nome, valor, priority, parcelas}; }
  return {ok:true, action:"criarAvista", nome, valor, priority};
}

function detectarTipoInvestimento(t){
  const mapa = {"poupança":"Poupança",poupanca:"Poupança",cdb:"CDB",tesouro:"Tesouro Direto",lci:"Renda Fixa (LCI/LCA)",lca:"Renda Fixa (LCI/LCA)","renda fixa":"Renda Fixa (LCI/LCA)","ação":"Ações","ações":"Ações",acoes:"Ações",bolsa:"Ações",fii:"Fundos Imobiliários (FIIs)","fundo imobiliário":"Fundos Imobiliários (FIIs)","fundo imobiliario":"Fundos Imobiliários (FIIs)",fundo:"Fundos de Investimento",etf:"ETFs",cripto:"Criptomoedas",bitcoin:"Criptomoedas",btc:"Criptomoedas","previdência":"Previdência Privada",previdencia:"Previdência Privada"};
  for (const [k,v] of Object.entries(mapa)) if (t.includes(k)) return v;
  return null;
}
function parseInvestimento(texto, lista){
  const t = texto.toLowerCase();
  const valor = extrairValor(texto);
  const isResgate = V_RESGATAR.some(v=>t.includes(v));
  const item = encontrarItem(texto, lista);
  if (item){ if(!valor) return {ok:false,msg:"Não identifiquei o valor."}; return {ok:true, action:isResgate?"resgatar":"contribuir", item, valor}; }
  if (!/(aportar|aportei|investir|investi)/.test(t) || !valor) return {ok:false,msg:null};
  const tipo = detectarTipoInvestimento(t) || "Outros";
  let nome = limpar(texto,["aportar","aportei","investir","investi","comprar","comprei","coloquei","no","na","em","de","reais","mil"]);
  if (!nome) nome = tipo;
  return {ok:true, action:"criarEContribuir", nome, tipo, valor};
}

function valorProximaParcela(meta){ const restam=meta.installments-meta.installmentsPaid; if(restam<=1) return round2(meta.price-meta.saved); return round2(meta.price/meta.installments); }
function proximaDataParcela(meta){
  if (!meta.dueDay || !meta.criadoEm) return null;
  const criado = new Date(meta.criadoEm+"T00:00:00");
  return new Date(criado.getFullYear(), criado.getMonth()+meta.installmentsPaid, meta.dueDay);
}
function proximaDataMensalidade(m){
  const hojeD = new Date(); hojeD.setHours(0,0,0,0);
  let alvo = new Date(hojeD.getFullYear(), hojeD.getMonth(), m.dueDay);
  if (alvo < hojeD) alvo = new Date(hojeD.getFullYear(), hojeD.getMonth()+1, m.dueDay);
  return alvo;
}

/* ===================== débito automático das mensalidades vencidas ===================== */
function processarCobrancasAutomaticas(dataAtual){
  const hojeD = new Date(); hojeD.setHours(0,0,0,0);
  const novasTransacoes = [];
  const resumo = [];
  const mensalidadesAtualizadas = dataAtual.mensalidades.map(m => {
    if (!m.active) return m;
    let prox = m.proximaCobranca ? new Date(m.proximaCobranca+"T00:00:00") : proximaDataMensalidade(m);
    let vezes = 0;
    while (prox <= hojeD && vezes < 24) {
      novasTransacoes.push({ id: uid("t"), type:"gasto", amount:m.amount, category:m.category||"Assinaturas", desc:`Mensalidade automática: ${m.name}`, date: prox.toISOString().slice(0,10) });
      vezes++;
      prox = new Date(prox.getFullYear(), prox.getMonth()+1, m.dueDay);
    }
    if (vezes>0) resumo.push(`${m.name} ${fmt(m.amount)}${vezes>1?` ×${vezes}`:""}`);
    return { ...m, proximaCobranca: prox.toISOString().slice(0,10) };
  });
  if (!novasTransacoes.length) return { data: dataAtual, mudou:false, resumo:[] };
  return {
    data: { ...dataAtual, mensalidades: mensalidadesAtualizadas, transactions: [...novasTransacoes, ...dataAtual.transactions] },
    mudou: true,
    resumo
  };
}

