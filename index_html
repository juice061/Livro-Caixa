function Consultor({data, saldo, totalReservado, totalInvestido, patrimonioTotal, actions}) {
  const [mensagens, setMensagens] = useState([
    {autor:"ia", texto:"Oi! Sou seu consultor financeiro. Me conta um gasto, um ganho, uma meta nova, ou pergunta algo tipo \"como tá minha grana esse mês?\" que eu tento ajudar 🙂"}
  ]);
  const [texto, setTexto] = useState("");
  const [carregando, setCarregando] = useState(false);
  const [config] = useState(()=>lerConfig());
  const boxRef = useRef(null);

  useEffect(()=>{ if(boxRef.current) boxRef.current.scrollTop = boxRef.current.scrollHeight; },[mensagens, carregando]);

  const contexto = () => `Saldo em caixa: ${fmt(saldo)}. Reservado em metas: ${fmt(totalReservado)}. Investido: ${fmt(totalInvestido)}. Patrimônio total: ${fmt(patrimonioTotal)}. `
    + `Metas financeiras: ${data.metasFinanceiras.map(m=>`${m.name} (${fmt(m.saved)}/${fmt(m.target)})`).join("; ")||"nenhuma"}. `
    + `Metas materiais: ${data.metasMateriais.map(m=>`${m.name} (${fmt(m.saved)}/${fmt(m.price)}${m.mode==="parcelado"?`, parcela ${m.installmentsPaid}/${m.installments}`:""})`).join("; ")||"nenhuma"}. `
    + `Investimentos: ${data.investimentos.map(i=>`${i.name} (${i.type}): ${fmt(i.amount)}`).join("; ")||"nenhum"}. `
    + `Mensalidades ativas: ${data.mensalidades.filter(m=>m.active).map(m=>`${m.name} ${fmt(m.amount)} (dia ${m.dueDay})`).join("; ")||"nenhuma"}.`;

  function tentarAcao(msg){
    let r = parseRapido(msg);
    if (r && /(gastei|paguei|comprei|ganhei|recebi)/i.test(msg)) { actions.addTransacao(r); return `Beleza, registrei: ${r.type==="gasto"?"gasto":"ganho"} de ${fmt(r.amount)} em ${r.category}. 📝`; }
    let p = parseMetaFinanceira(msg, data.metasFinanceiras);
    if (p.ok) {
      if (p.action==="criar") { actions.addMetaFin({name:p.nome,target:p.valor,saved:0,deadline:p.deadline,linkedToInvestments:p.linked}); return `Criei a meta financeira "${p.nome}", alvo ${fmt(p.valor)}${p.linked?" (acompanhando investimentos)":""}. 🎯`; }
      if (p.action==="contribuir") { const res=actions.contribuir(p.item,p.valor,"financeira"); return res.ok?`Guardei ${fmt(p.valor)} em "${p.item.name}". ✅`:res.msg; }
      const res=actions.resgatar(p.item,p.valor,"financeira"); return res.ok?`Resgatei ${fmt(p.valor)} de "${p.item.name}".`:res.msg;
    }
    let mm = parseMetaMaterial(msg, data.metasMateriais);
    if (mm.ok) {
      if (mm.action==="criarAvista") { actions.addMetaMat({name:mm.nome,price:mm.valor,priority:mm.priority,saved:0,mode:"avista"}); return `Adicionei "${mm.nome}" na sua lista de desejos, ${fmt(mm.valor)}. 🛍️`; }
      if (mm.action==="criarParcelado") { actions.addMetaMat({name:mm.nome,price:mm.valor,priority:mm.priority,saved:0,mode:"parcelado",installments:mm.parcelas,installmentsPaid:0,dueDay:10,criadoEm:hoje()}); return `Criei "${mm.nome}" parcelado em ${mm.parcelas}x de ${fmt(mm.valor/mm.parcelas)}, vencendo todo dia 10.`; }
      if (mm.action==="contribuir") { const res=actions.contribuir(mm.item,mm.valor,"material"); return res.ok?`Guardei ${fmt(mm.valor)} em "${mm.item.name}".`:res.msg; }
      if (mm.action==="resgatar") { const res=actions.resgatar(mm.item,mm.valor,"material"); return res.ok?`Resgatei ${fmt(mm.valor)} de "${mm.item.name}".`:res.msg; }
      if (mm.action==="pagarParcela") { const res=actions.pagarParcela(mm.item); return res.ok?`Parcela paga em "${mm.item.name}". 💳`:res.msg; }
      if (mm.action==="quitar") { const res=actions.quitarRestante(mm.item); return res.ok?`"${mm.item.name}" quitado! 🎉`:res.msg; }
    }
    let inv = parseInvestimento(msg, data.investimentos);
    if (inv.ok) {
      if (inv.action==="criarEContribuir") { const id=uid("inv"); actions.addInvestimento({id,name:inv.nome,type:inv.tipo,amount:0,historico:[]}); const res=actions.contribuir({id,name:inv.nome,amount:0},inv.valor,"investimento"); return res.ok?`Criei "${inv.nome}" (${inv.tipo}) com aporte de ${fmt(inv.valor)}. 📈`:res.msg; }
      if (inv.action==="contribuir") { const res=actions.contribuir(inv.item,inv.valor,"investimento"); return res.ok?`Aportei ${fmt(inv.valor)} em "${inv.item.name}".`:res.msg; }
      const res=actions.resgatar(inv.item,inv.valor,"investimento"); return res.ok?`Resgatei ${fmt(inv.valor)} de "${inv.item.name}".`:res.msg;
    }
    return null;
  }

  function gerarDicaLocal(){
    const dicas = [];
    if (saldo<0) dicas.push("Seu saldo em caixa tá negativo — vale revisar seus últimos lançamentos.");
    const porCategoria = {};
    data.transactions.filter(t=>t.type==="gasto").forEach(t=>{ porCategoria[t.category]=(porCategoria[t.category]||0)+t.amount; });
    const totalGastos = Object.values(porCategoria).reduce((a,b)=>a+b,0);
    const maior = Object.entries(porCategoria).sort((a,b)=>b[1]-a[1])[0];
    if (maior && totalGastos>0){ const pct=Math.round((maior[1]/totalGastos)*100); if(pct>=35) dicas.push(`${pct}% de tudo que você gastou até agora foi em "${maior[0]}". Vale ficar de olho.`); }
    if (patrimonioTotal>0){ const pctInv=Math.round((totalInvestido/patrimonioTotal)*100); if(pctInv<10) dicas.push(`Só ${pctInv}% do seu patrimônio tá investido. Se não for dinheiro reservado pra emergência ou meta de curto prazo, pode valer a pena investir mais.`); }
    const atrasadas = data.metasFinanceiras.filter(m=>m.deadline && new Date(m.deadline)<new Date() && m.saved<m.target);
    if (atrasadas.length) dicas.push(`Você tem meta(s) com prazo vencido e não concluída(s): ${atrasadas.map(m=>m.name).join(", ")}.`);
    if (!dicas.length) dicas.push("Seus números parecem organizados! Continue registrando os lançamentos certinho que eu vou conseguir te dar dicas cada vez melhores.");
    return dicas.join(" ");
  }

  async function enviar(){
    const msg = texto.trim(); if(!msg) return;
    setMensagens(m=>[...m,{autor:"user",texto:msg}]);
    setTexto("");
    const acao = tentarAcao(msg);
    if (acao) { setMensagens(m=>[...m,{autor:"ia",texto:acao}]); return; }
    if (config.apiKey) {
      setCarregando(true);
      try {
        const resp = await fetch("https://api.anthropic.com/v1/messages", {
          method:"POST",
          headers:{"Content-Type":"application/json","x-api-key":config.apiKey,"anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true"},
          body: JSON.stringify({ model: config.modelo||"claude-sonnet-5", max_tokens:500,
            system:`Você é um consultor financeiro pessoal e direto, respondendo sempre em português do Brasil, de forma breve e prática. Contexto financeiro real do usuário: ${contexto()} Não invente números que não foram passados. Deixe claro quando for uma opinião geral e não uma recomendação profissional individualizada.`,
            messages:[{role:"user",content:msg}] })
        });
        const json = await resp.json();
        if (json.error) throw new Error(json.error.message||"erro na API");
        const textoResp = (json.content||[]).map(b=>b.text||"").join("\n") || "Não consegui gerar uma resposta.";
        setMensagens(m=>[...m,{autor:"ia",texto:textoResp}]);
      } catch(e){
        setMensagens(m=>[...m,{autor:"ia",texto:`Não consegui falar com a IA de verdade agora (${e.message}). Uma dica com base nos seus números: ${gerarDicaLocal()}`}]);
      } finally { setCarregando(false); }
    } else {
      setMensagens(m=>[...m,{autor:"ia",texto: gerarDicaLocal()}]);
    }
  }

  return <div className="stack">
    <Card>
      <SectionTitle sub="Fale como preferir: 'gastei 40 no mercado', 'criar meta viagem de 3000', ou pergunte algo tipo 'como tá minha grana esse mês?'.">🧠 Consultor Financeiro</SectionTitle>
      <p className="muted" style={{marginBottom:10}}>{config.apiKey ? "Modo IA real ativado (configurado em Configurações)." : "Modo automático (sem custo) — analisa seus próprios números. Você pode ativar uma IA de verdade em Configurações."}</p>
      <div className="chat-box" ref={boxRef}>
        {mensagens.map((m,i)=>(<div key={i} className={"chat-msg "+(m.autor==="ia"?"chat-ia":"chat-user")}>{m.texto}</div>))}
        {carregando && <div className="chat-msg chat-ia"><span className="spin">⏳</span> pensando…</div>}
      </div>
      <div className="row g2" style={{marginTop:12}}>
        <input className="flex1" value={texto} placeholder="Fale com seu consultor…" onChange={e=>setTexto(e.target.value)} onKeyDown={e=>e.key==="Enter"&&enviar()} />
        <button className="btn-primary" onClick={enviar}>Enviar</button>
      </div>
    </Card>
  </div>;
}

