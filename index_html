          const atual = m.linkedToInvestments ? (totalInvestido||0) : m.saved;
          return <Card key={m.id} accent="#B08D3F">
            <div className="row-between" style={{fontSize:14,marginBottom:6}}>
              <span style={{fontWeight:600}}>{m.name}</span>
              <span className="row g2"><span className="mono">{fmt(atual)} / {fmt(m.target)}</span><PercentTag value={(atual/m.target)*100} /></span>
